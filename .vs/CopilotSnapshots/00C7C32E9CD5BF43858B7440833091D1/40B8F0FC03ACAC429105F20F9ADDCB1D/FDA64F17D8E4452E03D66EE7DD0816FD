
# Run everything:
# docker compose up --build
#
# Open:
# http://localhost/swagger
#
# Stop:
# docker compose down
#
# Stop and delete database data:
# docker compose down -v
#
# Secrets are stored in .env beside this file.

services:

  # ---------- PostgreSQL Database ----------
  postgres:
    image: postgres:16
    container_name: fundoo-postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: FundooNotes
    ports:
      - "5433:5432"
    volumes:
      - fundoo-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d FundooNotes"]
      interval: 5s
      timeout: 5s
      retries: 10

  # ---------- Messaging Services API ----------
  messagingservicesapi:
    build:
      context: .
      dockerfile: MessagingServices/MessagingServiceAPI/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:8080

      Smtp__Host: smtp.gmail.com
      Smtp__Port: "587"
      Smtp__Username: ${SMTP_USERNAME}
      Smtp__Password: ${SMTP_PASSWORD}
      Smtp__FromEmail: ${SMTP_USERNAME}
      Smtp__FromName: Fundoo Notes

    expose:
      - "8080"

  # ---------- Fundoo Notes API ----------
  fundoonotes:
    build:
      context: .
      dockerfile: Fundoo/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_URLS: http://+:8080

      ConnectionStrings__FundooConnection: "Host=postgres;Port=5432;Database=FundooNotes;Username=postgres;Password=${POSTGRES_PASSWORD}"

      Jwt__Key: ${JWT_KEY}

      MessageService__BaseUrl: http://messagingservicesapi:8080/

      Database__MigrateOnStartup: "true"
      ASPNETCORE_FORWARDEDHEADERS_ENABLED: "true"

    deploy:
      replicas: 2

    expose:
      - "8080"

    depends_on:
      postgres:
        condition: service_healthy
      messagingservicesapi:
        condition: service_started

  # ---------- Nginx Reverse Proxy ----------
  nginx:
    image: nginx:alpine
    container_name: fundoo-nginx
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - fundoonotes

# ---------- Persistent Volumes ----------
volumes:
  fundoo-pgdata:
