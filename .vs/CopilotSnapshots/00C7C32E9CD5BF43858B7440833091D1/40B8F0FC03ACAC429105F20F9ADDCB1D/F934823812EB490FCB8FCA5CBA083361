```dockerfile
# ---------- Stage 1: Build ----------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY MessagingServices/MessagingServiceAPI/MessagingServiceAPI.csproj MessagingServices/MessagingServiceAPI/
RUN dotnet restore MessagingServices/MessagingServiceAPI/MessagingServiceAPI.csproj

COPY MessagingServices/MessagingServiceAPI/ MessagingServices/MessagingServiceAPI/
RUN dotnet publish MessagingServices/MessagingServiceAPI/MessagingServiceAPI.csproj -c Release -o /app/publish --no-restore

# ---------- Stage 2: Runtime ----------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8080

ENTRYPOINT ["dotnet", "MessagingServiceAPI.dll"]
```