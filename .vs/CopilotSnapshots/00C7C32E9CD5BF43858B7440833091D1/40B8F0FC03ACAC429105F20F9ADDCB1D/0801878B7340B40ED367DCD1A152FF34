```dockerfile
# ---------- Stage 1: Build ----------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY MessagingServicesAPI/MessagingServicesAPI.csproj MessagingServicesAPI/
RUN dotnet restore MessagingServicesAPI/MessagingServicesAPI.csproj

COPY MessagingServicesAPI/ MessagingServicesAPI/
RUN dotnet publish MessagingServicesAPI/MessagingServicesAPI.csproj -c Release -o /app/publish --no-restore

# ---------- Stage 2: Runtime ----------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8080

ENTRYPOINT ["dotnet", "MessagingServicesAPI.dll"]
```